---
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  {%- assign base = site.url | default: site.github.url -%}

  <!-- Homepage -->
  <url>
    <loc>{{ base }}/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- Posts -->
  {% for post in site.posts %}
    <url>
      <loc>{{ base }}{{ post.url | remove: 'index.html' }}</loc>
      {% if post.date %}
      <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
      {% endif %}
      <changefreq>monthly</changefreq>
      <priority>0.8</priority>
    </url>
  {% endfor %}

  <!-- Projects (collection) -->
  {% assign sortedprojects = site.projects | sort: "initial-release" | reverse %}
  {% for project in sortedprojects %}
    <url>
      <loc>{{ base }}{{ project.url }}</loc>
      {% if project.date %}
      <lastmod>{{ project.date | date_to_xmlschema }}</lastmod>
      {% endif %}
      <changefreq>monthly</changefreq>
      <priority>0.7</priority>
    </url>
  {% endfor %}

  <!-- Pages -->
  {% for page in site.pages %}
    {% if page.url and page.sitemap != false and page.layout != 'feed' and page.layout != 'error' %}

      <url>
        <loc>{{ base }}{{ page.url | remove: 'index.html' }}</loc>

        {% if page.last_modified_at %}
        <lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
        {% endif %}

        <changefreq>yearly</changefreq>
        <priority>0.5</priority>
      </url>

    {% endif %}
  {% endfor %}

</urlset>