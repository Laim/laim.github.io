---
layout: null
permalink: /feed/projects.xml
---

<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }} - Projects Feed</title>
  <link href="{{ site.url }}/feed/projects.xml" rel="self"/>
  <link href="{{ site.url }}"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}/</id>
  <author>
    <name>{{ site.author }}</name>
  </author>
  {% assign sortedprojects = site.projects | sort: "initial-release" | reverse %}
  {% for project in sortedprojects %} 
  <entry>
    <title>{{ project.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ project.url }}"/>
    <id>{{ site.url }}{{ project.url }}</id>
    <updated>{{ project.date | date_to_xmlschema }}</updated>
    <summary>{{ project.description | strip_html | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>